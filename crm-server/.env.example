NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/crm
JWT_ACCESS_SECRET_KEY=replace-with-a-long-random-secret
JWT_REFRESH_SECRET_KEY=replace-with-a-different-long-random-secret
PRODUCTION_URL=http://localhost:3000

# AWS credentials remain in use for S3 and other AWS services.
AWS_REGION=ap-south-1

# Google Gemini API
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL_ID=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=7000
GEMINI_MAX_RETRIES=0
