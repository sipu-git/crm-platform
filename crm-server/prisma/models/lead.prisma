model Leads {
    id           String     @id @default(cuid())
    tenant_id    String
    company_name String
    companyId    String
    contactId    String
    project_name String
    project_type String?
    assigned_to  String?
    source       Source
    status       LeadStatus
    created_by   String
    owner_name   String
    created_At   DateTime   @default(now())
    updated_at   DateTime   @updatedAt

    company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
    assignee Assignee? @relation(fields: [assigned_to], references: [id], onDelete: Cascade)
    creator  User      @relation(fields: [created_by], references: [id], onDelete: Cascade)
    tenant   Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
    contact  Contacts? @relation(fields: [contactId], references: [id], onDelete: Cascade)

    communications Communications[]
    deal           Deal[]

    @@index([tenant_id])
    @@index([assigned_to])
}
