model Tenant {
    id             String           @id @default(uuid())
    name           String
    user           User[]
    company        Company[]
    contacts       Contacts[]
    pipeline       Pipeline[]
    deals          Deal[]
    activities     Activities[]
    notification   Notification[]
    lead           Leads[]
    assignee       Assignee[]
    communications Communications[]
    audits         AuditLogs[]
    invoice        Invoice[]
    deviceToken  DeviceToken[]

    created_at     DateTime         @default(now())

    @@index([name])
}
