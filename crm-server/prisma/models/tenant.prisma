model Tenant {
    id             String           @id @default(uuid())
    name           String
    user           User[]
    company        Company[]
    contacts       Contacts[]
    pipeline       Pipeline[]
    deals          Deal[]
    activities     Activities[]
    notification   Notification[]
    lead           Leads[]
    assignee       Assignee[]
    communications Communications[]
    audits         AuditLogs[]
    invoice        Invoice[]
    deviceToken    DeviceToken[]
    project        Project[]
    created_at     DateTime         @default(now())

    // --- new fields ---
    gst_number     String?
    pan_number     String?
    address        String?
    city           String?
    state          String?
    country        String?
    pincode        String?
    website        String?
    logo_url       String?
    industry       String?
    company_size   String?
    status         TenantStatus     @default(ACTIVE)
    updated_at     DateTime         @updatedAt

    @@index([name])
}
