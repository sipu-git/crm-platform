{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",

    "outDir": "./dist",
    "rootDir": "./",

    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,   // ← add this
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true
  },
  "include": ["app.ts","server.ts","lambda.ts",  "express.d.ts","**/*.ts"],
  "exclude": ["node_modules", "dist","**/*.test.ts"]
}